      "usage": "Default user avatar"
    }
  },
  "icons": {
    "library": "lucide-react",
    "style": "Stroke width 1.5px for elegance, 2px for active states"
  },
  "motion": {
    "transitions": "transition-all duration-200 ease-in-out",
    "hover_lift": "hover:-translate-y-0.5",
    "page_enter": "animate-in fade-in slide-in-from-bottom-4 duration-500"
  },
  "accessibility": {
    "contrast": "Ensure 4.5:1 for normal text, 3:1 for large text.",
    "focus_states": "Visible focus rings on all interactive elements.",
    "aria": "Use aria-labels for icon-only buttons."
  },
  "universal_guidelines": [
    "Do not use gradients for text or backgrounds unless specified.",
    "Avoid 'Inter' for headings; use 'Public Sans'.",
    "Use 'JetBrains Mono' for all technical data (IDs, SKUs).",
    "Ensure all interactive elements have a data-testid.",
    "Use 'sonner' for toasts.",
    "Use 'lucide-react' for icons.",
    "Do not center-align main app container.",
    "Use 2-3x more spacing than typical designs."
  ],
  "instructions_to_main_agent": "Follow these guidelines strictly. Use the provided image URLs for placeholders. Implement the 'Slate & Violet' theme using Tailwind CSS variables. Prioritize the 'Bento' grid layout for the dashboard and dense tables for data lists."
}